# C Cafe — مثال متغيرات البيئة
# هذا الملف غير حساس ويُرفع إلى Git. لا تضع فيه أي قيمة حقيقية.
#
# تنبيه: التطبيق الحالي لا يقرأ هذا الملف ولا هذه المتغيرات بعد.
# الغرض منه توثيق الأسماء المتوقعة لمرحلة نقل الاستضافة والبيانات وتسجيل الدخول.
# الاستثناء: `npm run verify:supabase` فاحص إنتاج للقراءة فقط يقرأ
# CCAFE_PROJECT_REF وSUPABASE_URL وSUPABASE_ANON_KEY وSUPABASE_ACCESS_TOKEN
# من بيئة التشغيل، ولا ينفّذ كتابة أو تنظيفًا أو تعديل حسابات.
# طريقة النشر وصلاحيات الإدارة لم تُعتمد بعد.

# ---------------------------------------------------------------------------
# إعدادات عامة قد تظهر في المتصفح (ليست أسرارًا)
# ---------------------------------------------------------------------------

# عنوان الموقع النهائي، ويُستخدم لاحقًا في canonical وروابط المشاركة.
SITE_URL=

# عنوان مشروع Supabase (سيُملأ في مرحلة الربط).
SUPABASE_URL=

# المفتاح العام (anon) — مخصص للاستخدام في المتصفح ضمن حدود RLS.
SUPABASE_ANON_KEY=

# مرجع المشروع المسموح لأمر التحقق فقط (mzbhncsdpdbxsdswzruc).
# يرفض الأمر العمل على أي مشروع آخر.
CCAFE_PROJECT_REF=

# ---------------------------------------------------------------------------
# أسرار الخادم فقط (لا تُكشف للمتصفح ولا تُرفع إلى Git)
# ---------------------------------------------------------------------------

# مفتاح service role — يُستخدم في الخادم فقط. لا يوضع في كود الواجهة.
SUPABASE_SERVICE_ROLE_KEY=

# مفتاح وصول شخصي لأمر `npm run verify:supabase` فقط (قراءة إدارية).
# لا يستخدمه التطبيق ولا يوضع في المتصفح أو في Git.
SUPABASE_ACCESS_TOKEN=

# سر خادمي يعتمد به finalize الصور المرفوعة بعد التحقق الحقيقي من بايتاتها.
# يُضبط في بيئة Netlify فقط (Functions)، ولا يُرسل إلى المتصفح ولا يُخزَّن خامًا.
# قاعدة البيانات تحفظ بصمة SHA-256 فقط في media_secrets؛ لا تُكتب القيمة في Git.
# غيابه يجعل /api/admin/media/finalize يعيد 503 media_unavailable.
CCAFE_MEDIA_FINALIZE_TOKEN=

# ملاحظة: لا تُستخدم ADMIN_EMAILS كآلية صلاحيات معتمدة.
# من يملك صلاحية الإدارة وكيف تُتحقق ستُحدَّد في مرحلة التصميم التالية.
